    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
      "description": "Distribusi skor probabilitas prediksi. Pergeseran distribusi dari baseline mengindikasikan potensi Data Drift atau Model Decay.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Prediction Rate",
            "drawStyle": "line",
            "fillOpacity": 40,
            "gradientMode": "opacity",
