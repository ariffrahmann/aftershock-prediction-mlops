      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(rate(http_requests_total{job=\"model-serving\", endpoint=\"/invocations\"}[1m]))",
          "legendFormat": "Total RPS",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(rate(http_requests_total{job=\"model-serving\", endpoint=\"/invocations\", status_code=~\"2..\"}[1m]))",
          "legendFormat": "Success (2xx)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(rate(http_requests_total{job=\"model-serving\", endpoint=\"/invocations\", status_code=~\"5..\"}[1m]))",
          "legendFormat": "Error (5xx)",
