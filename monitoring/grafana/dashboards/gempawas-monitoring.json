      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(rate(process_cpu_seconds_total{job=\"model-serving\"}[1m])) by (replica) * 100",
          "legendFormat": "CPU – {{replica}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "avg(rate(process_cpu_seconds_total{job=\"model-serving\"}[1m])) * 100",
          "legendFormat": "CPU – Average All Replicas",
          "refId": "B"
        }
      ],
      "title": "CPU Usage per Replica",
