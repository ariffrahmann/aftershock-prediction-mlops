          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(rate(prediction_score_bucket{job=\"model-serving\", le=\"0.5\"}[5m])) - sum(rate(prediction_score_bucket{job=\"model-serving\", le=\"0.3\"}[5m]))",
          "legendFormat": "Score [0.3 – 0.5] ← threshold zone",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(rate(prediction_score_bucket{job=\"model-serving\", le=\"0.7\"}[5m])) - sum(rate(prediction_score_bucket{job=\"model-serving\", le=\"0.5\"}[5m]))",
