          "legendFormat": "P99 (Tail)",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "histogram_quantile(0.50, sum(rate(model_inference_duration_seconds_bucket{job=\"model-serving\"}[2m])) by (le)) * 1000",
          "legendFormat": "Inference Only P50",
          "refId": "D"
        }
