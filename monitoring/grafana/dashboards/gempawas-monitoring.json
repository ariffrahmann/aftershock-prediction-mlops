      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "sum(http_requests_in_progress{job=\"model-serving\"})",
          "legendFormat": "In Progress",
          "refId": "A"
        }
      ],
      "title": "Requests In Progress",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 1    }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
          "expr": "increase(model_predictions_total{job=\"model-serving\"}[5m])",
          "legendFormat": "Predictions (5m)",
          "refId": "A"
        }
      ],
      "title": "Predictions (last 5m)",
      "type": "stat"
    },

    {
      "collapsed": false,
