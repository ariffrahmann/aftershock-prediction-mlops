    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus-gempawas" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Memory (MB)",
